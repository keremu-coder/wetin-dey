# Wetin Dey — environment variables.
# Copy to .env.local and fill with real values. Never commit .env.local.

# ── Supabase ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Session ──
# Must be at least 32 random characters. Rotating this logs everyone out.
SESSION_SECRET=

# ── Recovery codes ──
# HMAC key for recovery-code hashes. Must be set on any deployment that
# generates recovery codes.
RECOVERY_HASH_SECRET=

# ── Cron / sweep ──
# Bearer token for /api/radar/sweep. Without it the sweep returns 500.
# Set as a GitHub Actions repo secret named CRON_SECRET as well.
CRON_SECRET=

# ── AI + moderation ──
# Groq — report formalization + voice transcription.
GROQ_API_KEY=

# ── Telegram mirror (public feed only) ──
# Reviewed civic reports are mirrored to a public channel. Unset disables it.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=

# ── Push notifications (Android) ──
# Firebase service account JSON, base64-encoded single-line.
FCM_SERVICE_ACCOUNT_JSON=
NEXT_PUBLIC_NATIVE_PUSH_ENABLED=false

# ── Web push (VAPID) ──
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@wetindey.app