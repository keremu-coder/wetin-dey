<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
    </style>

    <!--
      Launch theme.

      We use a solid dark colour instead of the default @drawable/splash
      PNG. The default splash drawable is light-on-light and causes a
      white flash before the WebView paints. A solid black frame blends
      into the app's html/body background (#0a0a0a), so the user never
      sees a light frame between launch and first paint.

      When branded splash assets are ready (you will need an assets/
      folder with a dark splash.png), run:

        npx @capacitor/assets generate

      which regenerates every splash.png variant under
      android/app/src/main/res/drawable-*. Then swap @android:color/black
      back to @drawable/splash.
    -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@android:color/black</item>
    </style>
</resources>