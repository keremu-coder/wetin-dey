# === Wetin Dey: keep rules ===
# Capacitor plugins are called by reflection, so R8 cannot see their
# usages. Without these keeps, the release build crashes on plugin load.
-keep class com.wetindey.app.** { *; }
-keep class com.getcapacitor.** { *; }
-keep @com.getcapacitor.annotation.CapacitorPlugin class * { *; }
-keepclassmembers class * {
    @com.getcapacitor.PluginMethod public *;
}
-keep class com.equimaps.capacitor_background_geolocation.** { *; }
-keepattributes *Annotation*,Signature,InnerClasses